<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:fitsSystemWindows="true">

    <!-- 顶部图片区域 -->
    <RelativeLayout
        android:id="@+id/imageContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="45"
        android:padding="16dp">

        <ImageView
            android:id="@+id/melodyImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/melody_default"
            android:contentDescription="美乐蒂" />

        <!-- 设置按钮 -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:contentDescription="设置"
            android:padding="4dp" />

    </RelativeLayout>

    <!-- 文本对话框区域 -->
    <LinearLayout
        android:id="@+id/chatContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="30"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <!-- "我想" 标题 (猜测答案时显示) -->
        <TextView
            android:id="@+id/tvGuessTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="我想"
            android:textSize="28sp"
            android:textColor="@color/text_dark"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 猜测的答案文本 -->
        <TextView
            android:id="@+id/tvGuessAnswer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textSize="18sp"
            android:textColor="@color/text_light"
            android:visibility="gone" />

        <!-- 对话框背景 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/chat_box_bg"
            android:padding="16dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/tvDialogText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/text_dark"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.3" />

            </ScrollView>

        </FrameLayout>

    </LinearLayout>

    <!-- 按钮区域 -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="25"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:gravity="center">

        <!-- 开始界面按钮 -->
        <LinearLayout
            android:id="@+id/startButtons"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="visible">

            <Button
                android:id="@+id/btnStartGame"
                style="@style/GoldButtonStyle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/start_game" />

            <Button
                android:id="@+id/btnExitGame"
                style="@style/GoldButtonStyle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/exit_game" />

        </LinearLayout>

        <!-- 游戏中按钮 - 第一行：或许是 / 或许不是 -->
        <LinearLayout
            android:id="@+id/gameButtonsRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btnMaybeYes"
                style="@style/GoldButtonStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/maybe_yes" />

            <Button
                android:id="@+id/btnMaybeNo"
                style="@style/GoldButtonStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/maybe_no" />

        </LinearLayout>

        <!-- 游戏中按钮 - 第二行：是 / 不知道 / 否 -->
        <LinearLayout
            android:id="@+id/gameButtonsRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnYes"
                style="@style/GoldButtonStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/yes" />

            <Button
                android:id="@+id/btnDontKnow"
                style="@style/GoldButtonStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="@string/dont_know" />

            <Button
                android:id="@+id/btnNo"
                style="@style/GoldButtonStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/no" />

        </LinearLayout>

        <!-- 确认答案按钮 - 是(对) / 否(不对) -->
        <LinearLayout
            android:id="@+id/confirmButtons"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">

            <Button
                android:id="@+id/btnConfirmYes"
                style="@style/GoldButtonStyle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/confirm_yes" />

            <Button
                android:id="@+id/btnConfirmNo"
                style="@style/GoldButtonStyle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/confirm_no" />

        </LinearLayout>

        <!-- 结果页面按钮 -->
        <LinearLayout
            android:id="@+id/resultButtons"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">

            <Button
                android:id="@+id/btnPlayAgain"
                style="@style/GoldButtonStyle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/play_again" />

            <Button
                android:id="@+id/btnBackToStart"
                style="@style/GoldButtonStyle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/back_to_start" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
